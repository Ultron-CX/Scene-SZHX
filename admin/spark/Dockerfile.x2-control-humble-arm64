FROM nvcr.io/nvidia/cuda:13.0.0-runtime-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    ROS_DISTRO=humble \
    ROS_LOCALHOST_ONLY=1 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    REAL_ROBOT_COMMANDS=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl gnupg locales software-properties-common \
    && locale-gen en_US.UTF-8 \
    && add-apt-repository universe \
    && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
       -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && printf '%s\n' \
       'deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main' \
       > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ros-humble-ros-base \
       ros-humble-joy \
       ros-humble-rmw-fastrtps-cpp \
       libegl1 libgl1 libglfw3 libx11-6 libxcb1 \
       libyaml-cpp0.7 libtbb12 libgomp1 \
       libboost-filesystem1.74.0 ros-humble-hpp-fcl libnlopt0 \
       python3-pip python3-yaml procps tini xvfb xauth \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
